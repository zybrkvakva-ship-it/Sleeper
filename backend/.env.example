# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://sleeper:password@localhost:5432/sleeper
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sleeper
DB_USER=sleeper
DB_PASSWORD=your_password_here

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta
# Recommended: use Helius for production (more reliable, higher rate limits)
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_API_KEY=

# AllDomains ANS Program
ANS_PROGRAM_ID=ALTNSZ46uaAUU7XUV6awvdorLGqAsPwa9shm7h4uP2FK

# NFT Configuration (Metaplex Candy Machine v3)
CANDY_MACHINE_ID=<candy_machine_address_after_sugar_deploy>
GENESIS_NFT_PRICE_SKR=500
GENESIS_NFT_SUPPLY=10000

# Seeker Device NFT (Solana Mobile hardware device — Token-2022, soulbound)
SEEKER_DEVICE_NFT_MINT_AUTHORITY=GT2zuHVaZQYZSyQMgJPLzvkmyztfyXg2NJunqFp4p3A4

# SKR Guardian Staking Program
SKR_STAKING_PROGRAM_ID=SKRskrmtL83pcL4YqLWt6iPefDqwXQWHSw9S9vz94BZ

# SKR Token (for boost payments)
SKR_TOKEN_MINT=<skr_token_mint_address>
TREASURY_WALLET=<treasury_wallet_address>

# SLEEP Token (for reward claims — keep TREASURY_KEYPAIR secret, never expose)
SLEEP_TOKEN_MINT=<sleep_spl_mint_address>
TREASURY_KEYPAIR=<base58_encoded_treasury_private_key>
MIN_CLAIM_AMOUNT=100
CLAIM_COOLDOWN_HOURS=24

# Economy Constants
SEASON_POOL=5000000
MAX_DEVICES=150000
MAX_SOCIAL_BOOST=0.4
MAX_TOTAL_MULTIPLIER=6.0

# Security (REQUIRED — generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
API_KEY_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ADMIN_SECRET=CHANGE_ME_min_32_chars_openssl_rand_hex_32

# TGE (Token Generation Event)
TGE_ENABLED=false
TGE_DATE=2026-06-01T00:00:00Z

# CORS (comma-separated; must be set in production or all cross-origin requests are rejected)
ALLOWED_ORIGINS=https://seekermining.com,https://app.seekermining.com

# WebSocket
WS_PORT=3001
WS_HEARTBEAT_INTERVAL=30000

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
