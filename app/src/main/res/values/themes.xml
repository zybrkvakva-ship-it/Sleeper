<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 theme with splash screen support -->
    <style name="Theme.Sleeper" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Splash screen customization -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_icon_bg</item>
        <item name="android:windowSplashScreenExitTransition">@transition/splash_exit</item>

        <!-- Base background & UI colors -->
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>

        <!-- Enable Material 3 dynamic color scheme -->
        <item name="colorScheme">@style/Theme.Sleeper.ColorScheme</item>
    </style>

    <!-- Optional explicit color scheme for dynamic colors (API 31+) -->
    <style name="Theme.Sleeper.ColorScheme" parent="ThemeOverlay.Material3.Light">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorPrimaryOn">@color/primary_on</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorSecondaryOn">@color/secondary_on</item>
    </style>

    <!-- Dark variant (inherits from Material3 DayNight) -->
    <style name="Theme.Sleeper.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>
</resources>